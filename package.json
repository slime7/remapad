{
  "name": "remapad-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check": "node scripts/pocketjs.mjs check",
    "compile": "node scripts/pocketjs.mjs compile",
    "build": "node scripts/pocketjs.mjs build",
    "dev": "node scripts/pocketjs.mjs web",
    "native": "node scripts/pocketjs.mjs native",
    "test:e2e": "pnpm --filter remapad-ui run test:e2e",
    "test:e2e:headed": "pnpm --filter remapad-ui run test:e2e:headed",
    "test:firmware": "node scripts/firmware-test.mjs",
    "test:pc": "cd pc && uv run python -m unittest discover -s tests -t .",
    "lint": "pnpm --filter remapad-ui run lint",
    "lint:fix": "pnpm --filter remapad-ui run lint:fix"
  }
}
