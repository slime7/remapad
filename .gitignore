# ESP-IDF 固件编译产物与配置备份
build/
# sdkconfig 由 idf.py 依据 sdkconfig.defaults 生成，不是事实源
firmware/sdkconfig
sdkconfig.old
sdkconfig.defaults.old
dependencies.lock
managed_components/
compile_commands.json

# Node / Bun 前端依赖与产物
node_modules/
# 快照目录内的依赖链接与编译缓存
ui/vendor/pocketjs/node_modules
ui/vendor/pocketjs/.cache/
dist/
ui/dist/
# 官方编译器在入口目录生成又删除的类型检查临时目录
ui/src/.pocketjs-app-check-*/
# Playwright 端到端测试的运行产物
ui/test-results/
ui/playwright-report/
.pocket/
ui/.pocket/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
# Python 脚本（scripts/ 与 pc/）运行后产生的字节码缓存
__pycache__/
*.pyc
# uv 为 pc/ 桥接程序建的虚拟环境（uv.lock 需要提交）
.venv/
# remapadctl --shot 落地的实机截图（调试产物，不进仓库）
pc/shots/
# 代理与调试的临时文件（脚本、抓包输出、截图、日志；见 AGENTS.md）
agent-temp/*
!agent-temp/.gitkeep

# Rust 编译临时产物 (若本地引入 Rust 渲染核心)
target/
# 固件目标编码目录与 Rust 产物同名，这里显式取消忽略
!firmware/main/target/

# 编辑器与 IDE 配置
.vscode/
.idea/
*.suo
*.user
*.userosv
*.sln.docstates
.clangd/

# 操作系统生成文件
.DS_Store
Thumbs.db
desktop.ini

# 临时文件与日志
*.tmp
*.bak
*.log
