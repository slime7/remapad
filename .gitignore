# ESP-IDF 固件编译产物与配置备份（build/ 是默认目录，build-noui 是 -DREMAPAD_UI=OFF 的构建目录）
build/
build-noui/
# sdkconfig 由 idf.py 依据 sdkconfig.defaults 生成，不是事实源
firmware/sdkconfig
sdkconfig.old
sdkconfig.defaults.old
dependencies.lock
managed_components/
compile_commands.json

# Python 脚本（scripts/ 与 pc/）运行后产生的字节码缓存
__pycache__/
*.pyc
# pnpm 时代的遗留依赖目录（Node 已移除，本目录可以直接删掉）
node_modules/
# uv 建的虚拟环境：仓库根一份，覆盖 scripts/ 与 pc/ 的工具（uv.lock 需要提交）
.venv/
# remapadctl --shot 落地的实机截图（调试产物，不进仓库）
pc/shots/
# 代理与调试的临时文件（脚本、抓包输出、截图、日志；见 AGENTS.md）
agent-temp/*
!agent-temp/.gitkeep

# Rust 编译产物（屏幕 UI 组件与宿主用例）
target/
# 固件目标编码目录与 Rust 产物同名，这里显式取消忽略
!firmware/main/target/

# 编辑器与 IDE 配置
.vscode/
.idea/
.zcode/
*.suo
*.user
*.userosv
*.sln.docstates
.clangd/

# 操作系统生成文件
.DS_Store
Thumbs.db
desktop.ini

# 临时文件与日志
*.tmp
*.bak
*.log
