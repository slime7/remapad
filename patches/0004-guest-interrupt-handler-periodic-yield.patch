+/* The interpreter polls the interrupt handler every ~10k instructions, so one
+ * uninterrupted JS_Eval would otherwise hold CPU 0 away from IDLE0 for the
+ * whole run (initial bundle eval: ~11 s) and trip the 5 s task watchdog, which
+ * subscribes the idle tasks. Time-gating a one-tick delay through the poll
+ * keeps IDLE0 fed; turns shorter than the gate never delay. See patches/0004. */
+#define GUEST_YIELD_INTERVAL_US 20000
+
 static int guest_interrupt(JSRuntime *runtime, void *opaque) {
   (void)runtime;
   pocketjs_guest_t *guest = opaque;
   if (guest == NULL)
     return 0;
+  const int64_t now = esp_timer_get_time();
+  if (now >= guest->next_yield_us) {
+    guest->next_yield_us = now + GUEST_YIELD_INTERVAL_US;
+    vTaskDelay(1);
+  }
